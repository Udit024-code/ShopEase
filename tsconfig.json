{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "5.0",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts",
		"scripts/generate-colors.js"
	],
	"exclude": ["node_modules", "supabase/functions"]
}
